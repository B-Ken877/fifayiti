// FIFAYITI domain model — with Competition + Group + Knockout support.
//
// DATABASE PROVIDER STRATEGY (spec P0.4):
//   The provider is chosen at MIGRATION TIME via the DATABASE_PROVIDER env
//   var (or the --schema argument to prisma). Local dev uses SQLite
//   (default); production PARIAJ financial data uses PostgreSQL.
//
//   Local dev:    DATABASE_PROVIDER=sqlite    DATABASE_URL=file:./dev.db
//   Staging/Prod: DATABASE_PROVIDER=postgresql DATABASE_URL=postgres://...
//
//   The financial models (Bettor, Wallet, LedgerEntry, BetOrder,
//   BettingMarket, OfficialEvent, SettlementTransaction, PaymentIntent,
//   Account, AccountEntry) carry PostgreSQL-specific constraints where
//   possible (e.g. the partial unique index on active markets). On SQLite
//   those constraints are approximated by application code + a runtime
//   check — see `enforceOneActiveMarket` in market-state.ts.

generator client {
  provider = "prisma-client-js"
}

// Default provider is SQLite for local dev. For production PostgreSQL, the
// `scripts/prisma-prod.sh` wrapper passes `--schema prisma/schema.postgres.prisma`
// (which sets provider = "postgresql") — same model definitions, different
// datasource block. The runtime client reads DATABASE_URL regardless.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────── Auth ─────────

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String
  role         AdminRole      @default(LIVE_OPERATOR)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  verifiedPlayers Player[]     @relation("PlayerVerifiedBy")
  recordedEvents  MatchEvent[]
}

enum AdminRole {
  PRESIDENT
  DIRECTOR
  LIVE_OPERATOR
  TEAM_ADMIN
}

// ───────── Competition ─────────
// Modeled after FIFA World Cup + UEFA Champions League patterns.
//   - World Cup 2022 (32 teams, 8 groups of 4, top 2 advance → R16, QF, SF, Final + 3rd place)
//   - World Cup 2026 (48 teams, 12 groups of 4, top 2 + 8 best thirds → R32, R16, QF, SF, Final + 3rd)
//   - Champions League (32 teams, 8 groups of 4, double round-robin → R16, QF, SF, Final — no 3rd)
// Federation tool: president chooses group_count, teams_per_group, qualifiers_per_group,
// has_third_place_match, rr_type (single or double round-robin).

model Competition {
  id            String            @id @default(cuid())
  name          String                                       // e.g. "FIFAYITI Koup 2026" — entered by President
  slug          String            @unique
  season        String            @default("2026")
  status        CompetitionStatus @default(DRAFT)
  format        CompetitionFormat @default(GROUPS_THEN_KNOCKOUT)
  rrType        RoundRobinType    @default(SINGLE)          // single or double round-robin in group stage
  groupCount    Int               @default(2)
  teamsPerGroup Int               @default(4)
  qualifiersPerGroup Int          @default(2)
  hasThirdPlaceMatch Boolean      @default(false)
  hasKnockoutPhase Boolean        @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  groups        Group[]
  matches       Match[]
  registrations TeamRegistration[]
}

enum CompetitionStatus {
  DRAFT
  OPEN                       // teams can register / be assigned
  IN_PROGRESS                // matches are being played
  COMPLETED                  // tournament finished
  ARCHIVED
}

enum CompetitionFormat {
  GROUPS_THEN_KNOCKOUT       // WC / UCL pattern
  GROUPS_ONLY                // league style — no KO
  KNOCKOUT_ONLY              // single-elimination bracket
}

enum RoundRobinType {
  SINGLE                     // each pair plays once
  DOUBLE                     // each pair plays twice (home & away) — UCL pattern
}

model Group {
  id            String       @id @default(cuid())
  competitionId String
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String                                     // "A", "B", "C", ...
  createdAt     DateTime     @default(now())

  teams       TeamRegistration[]
  matches     Match[]
}

model TeamRegistration {
  id            String       @id @default(cuid())
  teamId        String
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  groupId       String?
  group         Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  seedNumber    Int          @default(0)                    // for bracket seeding
  createdAt     DateTime     @default(now())

  @@unique([teamId, competitionId])
}

// ───────── Teams ─────────

model Team {
  id            String         @id @default(cuid())
  name          String
  shortName     String
  primaryColor   String         @default("#116B3A")
  secondaryColor String        @default("#F4C400")
  founded        String?
  homeVenue      String?
  venueAddress   String?
  venueRouter    String?
  venueConnectivity VenueConnectivity @default(MOYEN)
  logoUrl        String?
  photoUrl       String?
  status        TeamStatus     @default(PRE_KREYE)
  registeredAt  String?
  group         String         @default("A")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  players       Player[]
  homeMatches   Match[]        @relation("HomeTeam")
  awayMatches   Match[]        @relation("AwayTeam")
  events        MatchEvent[]
  replays       Replay[]
  registrations TeamRegistration[]
  donations     TeamDonation[]
  distributions TeamSupportDistribution[]
}

enum TeamStatus {
  PRE_KREYE
  ENSKRIPSYON_OUVE
  SOUMET
  AN_VERIFIKASYON
  VERIFYE
  AKTIF
}

enum VenueConnectivity {
  BON
  MOYEN
  FEBL
}

// ───────── Players ─────────

model Player {
  id           String         @id @default(cuid())
  teamId       String
  team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  jerseyNumber Int
  position     PlayerPosition
  dateOfBirth  String?
  idNumber     String?
  photoUrl     String?
  status       PlayerStatus   @default(AN_ATANT)
  submittedAt  String?
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?          @relation("PlayerVerifiedBy", fields: [verifiedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  eventsIn   MatchEvent[]       @relation("PlayerInEvent")
  eventsOut  MatchEvent[]       @relation("PlayerOutEvent")
  replays    Replay[]

  @@unique([teamId, jerseyNumber])
}

enum PlayerPosition {
  GK
  DEF
  MID
  FWD
}

enum PlayerStatus {
  AN_ATANT
  VERIFYE
  REFIZE
  DEMANDE_KOREKSYON
}

// ───────── Matches + Events ─────────
// Match now belongs to a Competition (optional) and may belong to a Group (group stage)
// or carry a bracketSlot (knockout stage: "R16-1", "QF-1", "SF-1", "FIN", "3RD").

model Match {
  id            String        @id @default(cuid())
  competitionId String?
  competition   Competition?  @relation(fields: [competitionId], references: [id])
  matchday      Int           @default(1)
  stage         StageKind     @default(GROUP)
  groupId       String?
  group         Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupLabel    String?                                          // "A" | "B" — denormalized
  bracketSlot   String?                                           // "R16-1" | "QF-1" | "SF-1" | "FIN" | "3RD"
  homeTeamId    String
  homeTeam      Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId    String
  awayTeam      Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore     Int          @default(0)
  awayScore     Int          @default(0)
  kickoff       DateTime     @default(now())
  venue         String?
  competitionName String     @default("FIFAYITI")                                  // denormalized competition name for display
  status        MatchStatus  @default(PWOGRAM)
  referee       String?
  commissioner  String?
  clock         Int          @default(0)
  half          String       @default("PRE")
  synced        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  events  MatchEvent[]
  replays Replay[]
  bettingMarkets BettingMarket[]
  officialEvents OfficialEvent[]
}

enum StageKind {
  GROUP
  R32
  R16
  QF
  SF
  FIN
  THIRD_PLACE
}

enum MatchStatus {
  PWOGRAM
  AN_DIRÈK
  FINI
  AN_ATANT_APWOVASYON
  REPORETE
}

model MatchEvent {
  id            String         @id @default(cuid())
  matchId       String
  match         Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  minute        Int
  half          Int            @default(1)
  kind          MatchEventKind
  teamId        String?
  team          Team?          @relation(fields: [teamId], references: [id])
  playerInId    String?
  playerIn      Player?        @relation("PlayerInEvent", fields: [playerInId], references: [id])
  playerOutId   String?
  playerOut     Player?        @relation("PlayerOutEvent", fields: [playerOutId], references: [id])
  description   String
  recordedById  String?
  recordedBy    User?          @relation(fields: [recordedById], references: [id])
  recordedAt    DateTime       @default(now())
  correctedFrom String?
  correctionNote String?
  createdAt     DateTime       @default(now())
}

enum MatchEventKind {
  GOL
  FOT
  KAT_JON
  KAT_WOUJ
  KONÈ
  RANPLASMAN
  KOMANSE
  MWATYE_TAN
  DEZYEM_MITAN
  FEN_MATCH
}

// ───────── Replays ─────────
//
// Instant-replay records. One row is created the moment the operator
// confirms a replay-eligible event (GOL today; cards/saves tomorrow).
// The LIVE broadcast replay is delivered to viewers instantly over the
// LiveKit data channel (client-side rolling buffer); this row is the
// durable archive record with the exact DVR timeline coordinates so a
// standalone clip can be materialized later from the broadcast recording
// (HLS egress session + PDT window) once object storage is configured.

model Replay {
  id         String      @id @default(cuid())
  matchId    String
  match      Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  title      String
  playerId   String?
  player     Player?     @relation(fields: [playerId], references: [id])
  teamId     String?
  team       Team?       @relation(fields: [teamId], references: [id])
  kind       ReplayKind
  minute     Int
  savedAt    DateTime    @default(now())
  thumbnail  String      @default("")
  permanent  Boolean     @default(true)

  // ── Instant-replay engine fields (v1) ──
  eventId     String?   // the MatchEvent that triggered this replay
  status      String    @default("PUBLISHED") // PUBLISHED | ARCHIVED | FAILED
  triggeredAt DateTime  @default(now())       // operator marker wall-time (server clock)
  preRollMs   Int       @default(5000)        // clip = [trigger-preRoll, trigger]
  slowMotionRate Float  @default(0.5)         // second pass playback rate
  sequenceMs  Int?      // estimated total wall duration (normal + slow passes)
  mediaRef    String?   // future: resolved clip URL (S3/DVR) once storage is wired
}

enum ReplayKind {
  GOL
  SAV
  KADON
  SUBSTITUSYON
  KAT
}

// ───────── FIFAYITI PARIAJ — P2P Betting Exchange ─────────
//
// Architecture: the Live Operator's official match events drive the
// settlement engine. The Betting Operator curates ONE active market at
// a time from a predefined template catalog. Users place fixed-stake
// bets that match against opposing positions at the EXACT same stake.
//
// Money is tracked via a double-entry ledger (LedgerEntry) — never via
// mutable balance fields alone. Wallet holds the current available +
// reserved balances (denormalized from the ledger for fast reads).
//
// ⚠️ Vercel/SQLite note: wallet writes are ephemeral on Vercel's
// serverless filesystem. The code is correct (atomic transactions,
// double-entry ledger, concurrency-safe) but a real Postgres backend
// is required before any real-money launch. See docs/BETTING-ARCHITECTURE.md.

// ── Bettor accounts ──
// Extends the existing User model with a betting-specific profile.
// Regular bettors register with email + password (no hardcoded accounts).
model Bettor {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  phone        String?
  status       BettorStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallet       Wallet?
  bets         BetOrder[]
  ledgerEntries LedgerEntry[]
  auditLogs    BettingAuditLog[]
  paymentIntents PaymentIntent[]
}

enum BettorStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

// ── Wallet ──
// Denormalized from the ledger for fast balance reads. All mutations
// go through the ledger (double-entry) — the wallet balances are a
// CACHE of the ledger state, updated atomically with each ledger entry.
//
// All amounts are in INTEGER minor units (centimes) — 1 HTG = 100
// centimes. NEVER use floating-point for money.
model Wallet {
  id              String   @id @default(cuid())
  bettorId        String   @unique
  bettor          Bettor   @relation(fields: [bettorId], references: [id])  // NO onDelete: Cascade — financial history must not be destroyed
  availableCentimes  BigInt @default(0)   // PROJECTION of Account(type=bettor_available).balanceCentimes
  reservedCentimes  BigInt @default(0)   // PROJECTION of Account(type=bettor_reserved).balanceCentimes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([bettorId])
}

// ── Ledger ──
// Immutable double-entry transaction log. Every money movement creates
// a new row — historical entries are NEVER modified. The `balanceAfter`
// field enables quick reconciliation (sum of all entries for a bettor
// must equal their wallet.available + wallet.reserved).
//
// Transaction types follow a strict vocabulary:
//   DEPOSIT        — funds added to wallet (external → wallet)
//   WITHDRAWAL     — funds removed (wallet → external)
//   BET_RESERVE    — funds moved from available → reserved (bet placed)
//   BET_RELEASE    — funds moved from reserved → available (bet cancelled)
//   BET_MATCH      — funds locked in a matched position (reserved → in-play)
//   BET_SETTLE_WIN — winning position settled (in-play → available + winnings)
//   BET_SETTLE_LOSS— losing position settled (in-play → forfeit)
//   BET_REFUND     — cancelled market refunded (in-play → available)
//   COMMISSION     — FIFAYITI's fee deducted from winnings
//   ADJUSTMENT     — manual correction (admin only, audited)
model LedgerEntry {
  id              String   @id @default(cuid())
  bettorId        String
  bettor          Bettor   @relation(fields: [bettorId], references: [id])  // NO onDelete: Cascade — financial history must not be destroyed
  amountCentimes BigInt                     // +credit / -debit in minor units
  type            LedgerType
  referenceType   String?                    // "bet_order" | "market" | "deposit" | ...
  referenceId     String?                    // the related entity's id
  balanceAfterCentimes BigInt                  // wallet balance after this entry
  createdAt       DateTime @default(now())
  metadata        String?                    // JSON blob for extra context

  @@index([bettorId, createdAt])
  @@index([referenceType, referenceId])
}

enum LedgerType {
  DEPOSIT
  WITHDRAWAL
  BET_RESERVE
  BET_RELEASE
  BET_MATCH
  BET_SETTLE_WIN
  BET_SETTLE_LOSS
  BET_REFUND
  COMMISSION
  ADJUSTMENT
  TEAM_DONATION
  DONATION_REFUND
  TEAM_DISTRIBUTION
  PLAYER_ALLOCATION
  DISTRIBUTION_REVERSAL
}

// ── Stake pools ──
// Backend-driven configuration of the allowed fixed stake amounts.
// The Betting Operator enables/disables pools without code changes.
// `order` controls the display order in the UI.
model StakePool {
  id            String   @id @default(cuid())
  amountCentimes BigInt  @unique            // e.g. 5000 = 50 HTG
  label         String                      // "50 HTG" (display)
  enabled       Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
}

// ── Market templates ──
// The predefined catalog of approved betting markets. The Betting
// Operator selects from these — they cannot create arbitrary markets.
// Each template defines: the question text (Creole), the selection
// structure, and the settlement rule (which official event resolves it).
model MarketTemplate {
  id            String   @id @default(cuid())
  code          String   @unique            // "NEXT_GOAL" | "ANOTHER_GOAL" | ...
  label         String                      // "Kiyès ki pral make?" (Creole)
  description   String?
  selectionMode  SelectionMode               // TWO_TEAM | YES_NO | OVER_UNDER
  settleOnEvent  String                     // event kind that triggers settlement
  settleRule    String                      // JSON: { "nextGoal": "winningSelection = scoringTeam" }
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())

  markets      BettingMarket[]
}

enum SelectionMode {
  TWO_TEAM       // Team A vs Team B
  YES_NO         // YES vs NO
  OVER_UNDER     // Over vs Under a threshold
}

// ── Betting markets ──
// An instance of a market template for a specific match. Only ONE
// market per match may be in OPEN/SETTLING state at a time (enforced
// server-side). The lifecycle is a strict state machine:
//
//   DRAFT → PUBLISHED → OPEN → SUSPENDED ↔ OPEN → CLOSED → SETTLING → SETTLED
//                                                 ↘ CANCELLED
model BettingMarket {
  id              String   @id @default(cuid())
  matchId         String
  match           Match    @relation(fields: [matchId], references: [id])
  templateId      String
  template        MarketTemplate @relation(fields: [templateId], references: [id])
  status          MarketStatus @default(DRAFT)
  question        String                       // denormalized from template (Creole)
  config          String                       // JSON: template-specific params (threshold, time window, etc.)
  publishedAt     DateTime?
  openedAt        DateTime?
  closedAt        DateTime?
  settledAt       DateTime?
  cancelledAt     DateTime?
  settleEventId   String?                      // the OfficialEvent that settled this market
  settleOutcome   String?                      // JSON: { "winningSelection": "HOME", "reason": "..." }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  selections      MarketSelection[]
  bets            BetOrder[]
  settlements     SettlementTransaction[]

  @@index([matchId, status])
  @@index([status])
}

enum MarketStatus {
  DRAFT
  PUBLISHED
  OPEN
  SUSPENDED
  CLOSED
  SETTLING
  SETTLED
  CANCELLED
  EXPIRED
}

// ── Market selections ──
// The predefined choices for a market (e.g. "DELMAS", "KENSCOFF" for
// NEXT_GOAL; "WI", "NON" for ANOTHER_GOAL). Each selection has a key
// used by the settlement engine to determine the winner.
model MarketSelection {
  id          String   @id @default(cuid())
  marketId    String
  market      BettingMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)
  key         String                        // "HOME" | "AWAY" | "YES" | "NO" | "OVER" | "UNDER"
  label       String                        // "DELMAS" (display, Creole)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  bets        BetOrder[]

  @@index([marketId])
  @@unique([marketId, key])
}

// ── Bet orders ──
// A user's bet on a market selection at a fixed stake. The matching
// engine pairs opposing bets at the SAME stake. Lifecycle:
//
//   CREATED → RESERVED → OPEN → MATCHED → SETTLED
//                     ↘ CANCELLED → FUNDS RELEASED
//   MATCHED → MARKET_CANCELLED → REFUNDED
model BetOrder {
  id              String   @id @default(cuid())
  bettorId        String
  bettor          Bettor   @relation(fields: [bettorId], references: [id])
  marketId        String
  market          BettingMarket @relation(fields: [marketId], references: [id])
  selectionId     String
  selection       MarketSelection @relation(fields: [selectionId], references: [id])
  stakeCentimes   BigInt                       // exact stake (must match opposing bet)
  status          BetStatus @default(CREATED)
  matchedWithId   String?                      // the opposing BetOrder this is matched with
  matchedAt       DateTime?
  settledAt       DateTime?
  settleOutcome   String?                      // "WIN" | "LOSS" | "REFUND"
  payoutCentimes  BigInt?                       // amount returned to bettor on settlement
  idempotencyKey  String?  @unique             // client-supplied to prevent duplicate submissions
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  matchedWith     BetOrder? @relation("BetMatch", fields: [matchedWithId], references: [id])
  inverseMatches  BetOrder[] @relation("BetMatch")

  @@index([marketId, status])
  @@index([bettorId, status])
  @@index([marketId, selectionId, stakeCentimes, status])
  @@index([stakeCentimes, status])
}

enum BetStatus {
  CREATED
  RESERVED
  OPEN
  MATCHED
  CANCELLED
  MARKET_CANCELLED
  SETTLED
}

// ── Official events (formalized for betting) ──
// The existing MatchEvent model is the live operator's raw event log.
// This model adds the formal fields needed for betting settlement:
// sequence numbers, PENDING/CONFIRMED/CANCELLED status, and supersession
// chains (event 108 supersedes cancelled event 102).
//
// A single MatchEvent may spawn one OfficialEvent (or none, for events
// that don't affect betting). The settlement engine reads OfficialEvents.
model OfficialEvent {
  id              String   @id @default(cuid())
  matchId         String
  match           Match    @relation(fields: [matchId], references: [id])
  matchEventId    String?  @unique           // link to the source MatchEvent — one OfficialEvent per MatchEvent
  sequenceNumber  Int
  eventType       String                     // GOL | GOAL_CANCELLED | YELLOW_CARD | ...
  teamId          String?
  playerId        String?
  matchTime       String?                    // "27:14"
  status          OfficialEventStatus @default(PENDING)
  supersedesId    String?                    // the OfficialEvent this corrects
  operatorId      String?                    // who created it
  metadata        String?                    // JSON blob
  createdAt       DateTime @default(now())
  confirmedAt     DateTime?
  cancelledAt     DateTime?

  supersedes      OfficialEvent? @relation("EventSupersession", fields: [supersedesId], references: [id])
  supersededBy    OfficialEvent[] @relation("EventSupersession")
  settlements     SettlementTransaction[]

  @@unique([matchId, sequenceNumber])
  @@index([matchId, status, eventType])
}

enum OfficialEventStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ── Audit log ──
// Every sensitive operator/system action is logged here. Never deleted.
model BettingAuditLog {
  id          String   @id @default(cuid())
  actorType   String                       // "betting_operator" | "live_operator" | "system" | "admin"
  actorId     String?                       // bettorId or staff id
  action      String                        // "market.publish" | "market.suspend" | "bet.place" | ...
  targetType  String?                       // "market" | "bet" | "wallet" | "event"
  targetId    String?
  beforeState String?                       // JSON snapshot
  afterState  String?                       // JSON snapshot
  reason      String?
  bettorId    String?
  bettor      Bettor?  @relation(fields: [bettorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([actorType, createdAt])
  @@index([targetType, targetId])
  @@index([bettorId, createdAt])
}

// ───────── PARIAJ FINANCIAL-SAFETY MODELS (spec P0.3 / P0.6 / P1.1 / P0.5) ─────────

// ── PaymentIntent — pending deposit awaiting provider webhook (spec P0.3) ──
// The client creates one of these via /api/betting/wallet/deposit/initiate.
// NO money is created at intent time. Money is created ONLY when the
// provider's webhook verifies a real payment (see /api/betting/webhooks/[provider]).
model PaymentIntent {
  id              String   @id @default(cuid())
  bettorId        String?                    // null for anonymous team donations
  provider        String                    // "moncash" | "natcash" | "demo"
  amountCentimes  BigInt
  currency        String   @default("HTG")
  status          String  @default("pending")  // pending | paid | failed | expired
  providerPaymentId String?                  // set by the webhook
  returnUrl       String
  redirectUrl     String?                    // provider's checkout URL (for the client)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  confirmedAt     DateTime?
  rawWebhookPayload String?                  // the verified webhook body (audit)

  bettor          Bettor?  @relation(fields: [bettorId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([bettorId, status, createdAt])
  @@index([status, expiresAt])
}

// ── SettlementTransaction — idempotent settlement record (spec P0.6) ──
// Exactly ONE row per (marketId, settleEventId) pair. The unique constraint
// guarantees that a duplicate settlement attempt (retry, server restart)
// cannot create a second financial effect — it just hits the unique
// constraint and the caller sees "already settled".
model SettlementTransaction {
  id              String   @id @default(cuid())
  marketId        String
  settleEventId   String
  settleEvent     OfficialEvent @relation(fields: [settleEventId], references: [id])  // FK — no free-form string
  outcome         String                      // "settled" | "refunded" | "no_action"
  winningSelectionKey String?
  winnerCount      Int     @default(0)
  loserCount       Int     @default(0)
  refundedCount    Int     @default(0)
  totalPayoutCentimes BigInt  @default(0)
  totalCommissionCentimes BigInt @default(0)
  metadata        String?
  createdAt       DateTime @default(now())

  market          BettingMarket @relation(fields: [marketId], references: [id])

  @@unique([marketId, settleEventId])
  @@index([marketId])
}

// ── Account — double-entry accounting (spec P1.1) ────────────────────
// Each Account is a bucket of money. Every financial movement creates TWO
// AccountEntry rows: a debit on one account + a credit on another, with
// matching amounts (balanced). The Wallet table is a denormalized view
// for fast reads; the AccountEntry table is the source of truth.
//
// Account types:
//   bettor_available    — the bettor's spendable balance
//   bettor_reserved     — funds locked in unmatched open bets
//   betting_in_play     — funds locked in matched positions (counter-party)
//   platform_custody    — FIFAYITI's custodial holding (deposits land here)
//   platform_commission — FIFAYITI's earned commission revenue
//   platform_settlement — clearing account during settlement
model Account {
  id              String   @id @default(cuid())
  type            String                     // platform_custody | platform_revenue | platform_settlement | bettor_available | bettor_reserved | team_support | player_earnings
  normalBalance   String   @default("CREDIT")  // DEBIT or CREDIT — controls signed delta interpretation
  bettorId        String?                    // null for non-bettor accounts
  teamId          String?                    // set for team_support accounts
  playerId        String?                    // set for player_earnings accounts
  currency        String   @default("HTG")
  balanceCentimes BigInt  @default(0)       // running balance (denormalized projection of AccountEntry)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries         AccountEntry[]

  // Application-level uniqueness; DB partial unique indexes added via SQL migration
  // for race-proof guarantees. See prisma/migrations/20260904_financial_hardening/migration.sql
  @@index([type])
  @@index([bettorId])
  @@index([teamId])
  @@index([playerId])
}

// ── AccountEntry — immutable double-entry line (spec P1.1) ────────────
// Each row is ONE side of a transaction. A balanced transaction always
// produces TWO rows with matching amounts on opposing sides (debit +
// credit). The `transactionId` groups the rows of a single transaction
// so reconciliation can verify Σ debits == Σ credits per transaction.
model AccountEntry {
  id              String   @id @default(cuid())
  transactionId   String
  transaction     FinancialTransaction @relation(fields: [transactionId], references: [id])
  accountId       String
  account         Account @relation(fields: [accountId], references: [id])  // NO onDelete: Cascade — financial history is immutable
  direction       String                     // "debit" | "credit" (CHECK enforced at DB level)
  amountCentimes BigInt                      // always > 0 (CHECK enforced at DB level)
  ledgerType      String                     // mirrors FinancialTransaction.type for query convenience
  referenceType   String?
  referenceId     String?
  createdAt       DateTime @default(now())
  metadata        String?

  @@index([accountId, createdAt])
  @@index([transactionId, createdAt])
  @@index([ledgerType])
  @@index([referenceType, referenceId])
}

// ── FinancialTransaction — canonical immutable transaction header ──
// Every financial operation creates exactly one FinancialTransaction +
// >=2 AccountEntry rows. The transaction is created in POSTING status,
// entries are written, balances updated, and then it transitions to POSTED.
// Posted transactions + entries are immutable (enforced by PostgreSQL triggers).
// Idempotency: idempotencyKey is unique; same key + same requestFingerprint
// returns the original result; same key + different fingerprint is rejected.
model FinancialTransaction {
  id                String   @id @default(cuid())
  type              String                     // TransactionType enum value
  status            String   @default("DRAFT")   // DRAFT | POSTING | POSTED | FAILED | REVERSED
  currency          String   @default("HTG")
  idempotencyKey    String   @unique           // unique per operation
  requestFingerprint String?                   // payload hash for idempotency validation
  referenceType     String?
  referenceId       String?
  metadata          String?
  createdBy         String?                    // actor identity (admin email / "system")
  postedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  entries           AccountEntry[]

  @@index([status, createdAt])
  @@index([referenceType, referenceId])
  @@index([type, createdAt])
}

// ── OutboxEvent — transactional outbox for the event → settlement chain (spec Part 7) ──
// The official-events route creates the MatchEvent + OfficialEvent +
// an OutboxEvent entry in the SAME transaction. A background poller (or
// webhook) processes the outbox: pushes LiveKit updates, triggers replay,
// fires the settlement engine. Each outbox row is processed exactly once
// (idempotency key = outbox id) — retries on failure are safe.
model OutboxEvent {
  id              String   @id @default(cuid())
  aggregateType   String                     // "match" | "market" | "bet"
  aggregateId     String
  eventType       String                     // "OfficialEventConfirmed" | "MarketSettled" | ...
  payload         String                     // JSON
  status          String   @default("pending")  // pending | processing | done | failed
  attempts        Int      @default(0)
  lastError       String?
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
}

// ── RateLimitAudit — record when rate limits fire (spec Part 6) ──────
// The in-memory store doesn't persist, but a 429 response logs a row here
// so admins can audit abuse patterns. (Cheap append-only; never queried
// in the hot path.)
model RateLimitAudit {
  id          String   @id @default(cuid())
  scope       String                     // "login" | "register" | "bet_place" | ...
  identifier  String                     // IP or bettorId
  limit       Int
  windowMs     Int
  createdAt   DateTime @default(now())

  @@index([scope, identifier, createdAt])
  @@index([createdAt])
}

// ───────── FIFAYITI SIPÒ — Team Support Economy ─────────
//
// Fans financially support their favorite team. 0% commission. Money
// flows into a Team Support Fund (an Account with type="team_support").
// FIFAYITI administers equal-share distributions to eligible players.
//
// ARCHITECTURE: reuses the existing Account/AccountEntry double-entry
// ledger. Team + player accounts are just Account rows with type set
// to "team_support" / "player_earnings" and teamId/playerId set.
// Donations flow through the same PaymentIntent → verified webhook
// → AccountEntry pipeline as bettor deposits.
//
// SEPARATION FROM PARIAJ: the business rules are distinct. A donation
// is never a betting transaction. A settlement never affects a team
// fund. The financial backbone (Account/AccountEntry) is shared, but
// the domain models (TeamDonation, TeamSupportDistribution) are
// separate from the betting models (BetOrder, BettingMarket).

// ── TeamDonation — a fan's contribution to a team's support fund ──
// Linked to a PaymentIntent (same payment flow as bettor deposits).
// NO money is credited until the payment provider's webhook verifies.
model TeamDonation {
  id              String   @id @default(cuid())
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id])
  paymentIntentId String   @unique           // the PaymentIntent that funds this donation
  amountCentimes  BigInt                     // total donated (centimes)
  currency        String   @default("HTG")
  status          TeamDonationStatus @default(PENDING)
  donorBettorId   String?                    // if the donor is a logged-in bettor
  donorName       String?                    // optional display name
  anonymous       Boolean  @default(true)
  message         String?                    // optional support message
  ledgerTransactionId String?                 // the AccountEntry transactionId (set on confirmation)
  confirmedAt     DateTime?
  refundedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([teamId, status, createdAt])
  @@index([paymentIntentId])
  @@index([status])
}

enum TeamDonationStatus {
  PENDING          // payment intent created, awaiting webhook
  CONFIRMED        // webhook verified, funds credited to team_support account
  REFUNDED         // payment failed / reversed, funds returned
  FAILED           // payment intent expired or failed
}

// ── TeamSupportDistribution — a batch distribution to eligible players ──
// Created by PRESIDENT/DIRECTOR (not TEAM_ADMIN). Equal-share principle:
// every eligible player gets the same amount. Remainder from uneven
// division is distributed deterministically (first N players get +1
// centime each, where N = remainder).
//
// IDEMPOTENCY: the batchNumber is unique per team. A double-click on
// "DISTRIBUTE" hits the unique constraint and the second attempt is
// rejected.
model TeamSupportDistribution {
  id              String   @id @default(cuid())
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id])
  batchNumber     Int                       // monotonic per-team (for idempotency)
  status          TeamDistributionStatus @default(DRAFT)
  totalAmountCentimes BigInt                 // amount being distributed
  eligiblePlayerCount Int                    // snapshot count
  perPlayerAmountCentimes BigInt             // base share (total / count)
  remainderCentimes BigInt  @default(0)    // leftover (total % count)
  remainderRecipients Int   @default(0)     // how many players get +1 centime
  eligibilitySnapshot String                // JSON: [{ playerId, firstName, lastName, jerseyNumber }]
  ledgerTransactionId String?               // the AccountEntry transactionId (set on execution)
  createdBy       String                   // admin role/id who created it
  executedBy      String?                   // admin role/id who executed it
  createdAt       DateTime @default(now())
  executedAt      DateTime?
  completedAt      DateTime?
  reversedAt       DateTime?
  reversalTransactionId String?
  failureReason    String?

  allocations     PlayerAllocation[]

  @@unique([teamId, batchNumber])
  @@index([teamId, status])
  @@index([status])
}

enum TeamDistributionStatus {
  DRAFT            // created, not yet reviewed
  PENDING          // reviewed, awaiting execution
  EXECUTING        // transaction in progress
  COMPLETED        // all allocations credited, transaction committed
  FAILED           // execution failed (rolled back)
  REVERSED         // completed but later reversed
}

// ── PlayerAllocation — one player's share within a distribution batch ──
// Child of TeamSupportDistribution. The `amountCentimes` may be
// `perPlayerAmountCentimes` OR `perPlayerAmountCentimes + 1` (for the
// first N remainder recipients).
model PlayerAllocation {
  id              String   @id @default(cuid())
  distributionId  String
  distribution    TeamSupportDistribution @relation(fields: [distributionId], references: [id])
  playerId        String
  playerName      String                     // snapshot (immutable)
  playerJerseyNumber Int                     // snapshot
  amountCentimes  BigInt                     // this player's share
  status          PlayerAllocationStatus @default(PENDING)
  ledgerTransactionId String?                 // set when credited
  creditedAt      DateTime?
  reversedAt      DateTime?
  createdAt       DateTime @default(now())

  @@unique([distributionId, playerId])
  @@index([distributionId, status])
  @@index([playerId])
}

enum PlayerAllocationStatus {
  PENDING          // allocation recorded, not yet credited
  CREDITED         // funds credited to player_earnings account
  REVERSED         // allocation reversed
  FAILED           // credit failed
}
