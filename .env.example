# FIFAYITI environment variables — copy this file to `.env` for local dev.
# In production, set these in the Vercel dashboard (NOT in this file —
# `.env` is gitignored and `.env.example` is committed but never loaded).

# ── Database ───────────────────────────────────────────────────────────
# Local dev: SQLite (no extra setup needed).
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# Production (PostgreSQL — Neon / Supabase / Vercel Postgres):
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# ── Session-signing secrets ────────────────────────────────────────────
# Generate fresh secrets for production with:
#   openssl rand -hex 32
# Min 32 chars. Missing secrets in production throw at boot (fail-closed).
FIFAYITI_AUTH_SECRET=DEV_ONLY_fifayiti_auth_secret_change_me_in_prod_0123456789abcdef
FIFAYITI_BETTING_SECRET=DEV_ONLY_fifayiti_betting_secret_change_me_in_prod_0123456789abcdef

# ── Payment providers (when integrating MonCash / Natcash) ──────────────
# Set these to enable real deposit/withdraw. While unset, the deposit
# endpoint returns "provider not configured" (no fake money).
# MONCASH_API_KEY=
# MONCASH_SECRET=
# MONCASH_BASE_URL=https://moncashbutton.digicelgroup.com
# NATCASH_API_KEY=
# NATCASH_SECRET=
# NATCASH_BASE_URL=https://api.natcash.ht

# ── Upstash Redis for hard rate-limiting (optional) ─────────────────────
# While unset, the in-memory per-lambda rate limiter is used (soft limit).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Broadcast / video integration (Phase 1 — optional boundary) ────────
# FIFAYITI_BROADCAST_PROVIDER selects which broadcast adapter the match
# events + phase routes use to push score/clock/replay updates.
#
#   livekit  (default) — push to LiveKit Cloud broadcast room (preserves
#                        existing FIFAYITI TV, HLS, DVR, replay behavior).
#   disabled           — no-op adapter. Match operations, betting
#                        settlement, and donations all work with the
#                        video stack entirely absent. Use this for
#                        offline-from-video matches, dev without
#                        LiveKit creds, or as a kill switch when the
#                        video stack is misbehaving.
# FIFAYITI_BROADCAST_PROVIDER=livekit

# LiveKit Cloud credentials (optional overrides — see src/lib/streaming/
# livekit-config.ts). The hardcoded fallback values are committed to
# git history and must be rotated; once rotated, set these in production
# so the fallback is never used.
# FIFAYITI_LIVEKIT_API_KEY=
# FIFAYITI_LIVEKIT_API_SECRET=
# FIFAYITI_LIVEKIT_HOST=fifayiti-mohh1dj4.livekit.cloud
